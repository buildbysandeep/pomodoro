{
  "name": "pomodoro-pwa",
  "private": true,
  "version": "1.0.0",
  "description": "Production-grade Pomodoro Timer PWA with real-time sync across devices",
  "scripts": {
    "dev": "turbo run build --filter=@pomodoro/shared && turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.14.0"
}
